{
  "expo": {
    "name": "For The King",
    "slug": "for-the-king",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fortheking",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fortheking.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "Add your huddle meeting dates to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Add and update your huddle meeting dates on your calendar."
      }
    },
    "android": {
      "package": "com.fortheking.app",
      "adaptiveIcon": {
        "backgroundColor": "#DEE5E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow For The King to add huddle meetings to your calendar."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#DEE5E5",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#082D0F"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "ForTheKing",
            "ios": "./assets/images/icon-for-the-king.png",
            "android": {
              "foregroundImage": "./assets/images/android-icon-for-the-king-foreground.png",
              "backgroundColor": "#F3EFE8"
            }
          }
        ]
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "For The King lets you attach photos of your journal pages to your notes.",
          "cameraPermission": "For The King uses the camera to photograph your journal pages.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A8874F",
          "defaultChannel": "default"
        }
      ],
      [
        "./plugins/withPathwayNotificationIcons",
        {
          "for-the-king": "./assets/images/notification-icon.png",
          "pc3-focuses": "./assets/images/notification-icon-pc3.png"
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "For The King uses the camera to scan your journal pages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "04d773b3-0680-4fe5-956d-2854cb832f01"
      }
    },
    "owner": "bespoketechnical"
  }
}
